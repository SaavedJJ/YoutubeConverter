{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convertidor-youtube",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-11-17",
  "containers": [
    {
      "class_name": "Converter",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CONVERTER", "class_name": "Converter" }]
  },
  "exports": {
    "Converter": { "type": "durable-object", "storage": "sqlite" }
  }
}
